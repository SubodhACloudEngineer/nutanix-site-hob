# Module downloads — populated at pipeline build time, never committed
infra/modules/

# Terraform local state and cache
.terraform/
*.tfstate
*.tfstate.backup

# NOTE: .terraform.lock.hcl is intentionally NOT ignored and IS committed.
# Gitignoring the lock file is correct for a shared module library, but wrong
# for a root module like this one: the lock file is what guarantees the CI
# agent resolves the same provider build and checksum that was tested locally.

# Variable files containing secrets — never commit root or infra-level tfvars
*.tfvars
# Exception: config/ holds non-sensitive environment inputs and IS committed
!config/*.tfvars

# Crash logs
crash.log
crash.*.log

# Override files (local developer customisations — never commit)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
