# Module downloads — populated at pipeline build time, never committed
infra/modules/

# Terraform local state and cache
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup

# Variable files containing secrets — never commit root or infra-level tfvars
*.tfvars
# Exception: config/ holds non-sensitive environment inputs and IS committed
!config/*.tfvars

# Crash logs
crash.log
crash.*.log

# Override files (local developer customisations — never commit)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
